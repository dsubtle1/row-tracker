# Row Tracker — environment variables
# Copy this file to .env and fill in your values. Never commit .env to git.

# Flask
SECRET_KEY=change-me-to-a-long-random-string

# Feature flags
USE_AI_WOD=false

# Anthropic API key — only needed if USE_AI_WOD=true. When set, the daily
# WOD's warm-up/cool-down/coaching notes are written by Claude instead of
# the static templates. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Concept2 API
C2_CLIENT_ID=
C2_CLIENT_SECRET=
C2_REFRESH_TOKEN=

# Email (Gmail SMTP)
# Use a Gmail App Password — not your account password.
# Generate one at: Google Account → Security → 2-Step Verification → App passwords
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-16-char-app-password

# Where badge/milestone/journey-completion notifications are sent.
# Optional — defaults to MAIL_USERNAME if left blank.
NOTIFY_EMAIL=
